generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id          String   @id @default(uuid())
  name        String
  gender      String?
  birthDate   DateTime?
  deathDate   DateTime?
  photoUrl    String?
  biography   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  fatherId    String?
  father      Person?  @relation("FatherChildren", fields: [fatherId], references: [id])
  fatherChildren Person[] @relation("FatherChildren")

  motherId    String?
  mother      Person?  @relation("MotherChildren", fields: [motherId], references: [id])
  motherChildren Person[] @relation("MotherChildren")

  // Spouse relationships (many-to-many through Relationship table)
  spouses     Relationship[] @relation("PersonSpouses1")
  spouseOf    Relationship[] @relation("PersonSpouses2")

  @@index([fatherId])
  @@index([motherId])
}

model Relationship {
  id          String   @id @default(uuid())
  type        String   // "MARRIAGE", "DIVORCE", etc.
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  person1Id   String
  person1     Person   @relation("PersonSpouses1", fields: [person1Id], references: [id], onDelete: Cascade)
  
  person2Id   String
  person2     Person   @relation("PersonSpouses2", fields: [person2Id], references: [id], onDelete: Cascade)

  @@unique([person1Id, person2Id])
  @@index([person1Id])
  @@index([person2Id])
}
